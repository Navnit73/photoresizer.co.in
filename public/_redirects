# NOTE: the www -> apex host redirect cannot live here — Cloudflare Workers Assets'
# _redirects only accepts relative paths (an absolute-URL rule broke the last deploy:
# "Invalid _redirects configuration: Only relative URLs are allowed"). Set that redirect
# up instead as a Cloudflare zone-level Redirect Rule (dashboard: Rules > Redirect Rules),
# matching hostname equals "www.photoresizer.co.in" -> redirect to
# "https://photoresizer.co.in${uri.path}" with a 301, Preserve query string on.

# /de, /es, /fr, /pt routes were removed on 2026-10-04 with no redirect,
# leaving previously indexed/backlinked locale URLs as hard 404s.
/de/* / 301
/es/* / 301
/fr/* / 301
/pt/* / 301

# Near-duplicate / mistyped KB-reduction URLs that were getting impressions with no real
# page behind them — point them at the closest existing, real content instead of 404ing.
/resize-image-20kb /resize-photo-20kb 301
/reduce-photo-size50kb /reduce-photo-size-50kb 301
/photo-resize-40kb /reduce-image-size-in-kb 301
